diff --git a/extras/package/apple/build.sh b/extras/package/apple/build.sh
index 90e5893..0b39099 100755
--- a/extras/package/apple/build.sh
+++ b/extras/package/apple/build.sh
@@ -479,10 +479,16 @@ gen_vlc_static_module_list()
 
     local array_list
     local declarations_list
+    local license_declarations
+    local license_array
+    local license_symbol
 
     for symbol in "${symbol_array[@]}"; do
         declarations_list+="VLC_ENTRY_FUNC(${symbol});\\n"
         array_list+="    ${symbol},\\n"
+        license_symbol="${symbol/vlc_entry__/vlc_entry_license__}"
+        license_declarations+="extern const char *${license_symbol}(void);\\n"
+        license_array+="    ${license_symbol},\\n"
     done
 
     printf "\
@@ -495,6 +501,12 @@ const vlc_plugin_cb vlc_static_modules[] = {\\n
 };" \
     "$declarations_list" "$array_list" >> "$output" \
       || abort_err "Failure writing static module list file"
+
+    # Keep each included module's license getter in the final Apple binary so
+    # release audits can inspect it even when unused symbols are stripped.
+    printf "\\n%b\\n__attribute__((used)) const char *(*const eptv_vlc_module_licenses[])(void) = {\\n%b    NULL\\n};\\n" \
+      "$license_declarations" "$license_array" >> "$output" \
+      || abort_err "Failure writing module license list"
 }
 
